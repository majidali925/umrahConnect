# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGODB_URI=

# --- JWT (use long random values, different for each secret) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Admin JWT: separate secrets so user tokens can never act as admin tokens ---
# All four JWT secrets must be different from each other.
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=
# ADMIN_ACCESS_TOKEN_EXPIRES_IN=15m
# ADMIN_REFRESH_TOKEN_EXPIRES_IN=12h

# --- Frontend origins allowed by CORS (comma-separated) ---
# Marketplace site: allowed on every route except /api/v1/admin
CLIENT_URL=http://localhost:8080
# Admin panel: allowed on /api/v1/admin only
ADMIN_CLIENT_URL=http://localhost:8090

# --- Email ---
# Brevo (recommended): when BREVO_API_KEY is set, every email (verification codes included) is
# sent through Brevo's API. MAIL_FROM_EMAIL must be a verified sender or domain in Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=UmrahConnect
# SMTP: used only when BREVO_API_KEY is empty. Leave both empty in development to print
# emails to the console instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="UmrahConnect <no-reply@umrahconnect.pk>"
# Optional: receives a notification when vendors submit applications
ADMIN_NOTIFICATION_EMAIL=

# --- File storage (Cloudinary) ---
# All uploads (e.g. agency verification documents) are stored privately in Cloudinary under
# CLOUDINARY_FOLDER. Required in production; when empty in development, files go to ./uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=umrahconnect

# --- Hotel search (auto-fills hotel distance from the Haram on the package form) ---
# Uses OpenStreetMap Nominatim. The public server needs an identifying User-Agent,
# ideally with a contact URL or email: https://operations.osmfoundation.org/policies/nominatim/
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT="UmrahConnect/1.0 (https://your-domain.example)"

# --- Optional tuning ---
# COOKIE_SAMESITE=lax          # use "none" (with HTTPS) if frontend and backend are on different sites
# COOKIE_SECURE=               # defaults to true when NODE_ENV=production
# OTP_EXPIRES_IN_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# UPLOAD_MAX_FILE_SIZE_MB=5
# AUTH_RATE_LIMIT_MAX=20        # login/register/OTP attempts per IP per 15 minutes

# AUTH_RATE_LIMIT_MAX also sets the admin login budget (half of it, minimum 5)

# --- Super admin seed (used only by `npm run seed:admin`; remove after seeding) ---
# SUPER_ADMIN_NAME=Platform Admin
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
